---
import "./Footer.css";

interface Link {
  label: string;
  href: string;
}

interface Column {
  title: string;
  links: Link[];
}

interface Props {
  footer: {
    blurb: string;
    columns: Column[];
    year: number;
  };
}

const { footer } = Astro.props;
---

<footer class="footer" id="contact">
  <div class="shell footer__inner">
    <div class="footer__top">
      <div class="footer__signature">
        <div class="footer__lockup">
          <img
            class="footer__mark"
            src="/brand/immunos-mark.png"
            alt=""
            width="36"
            height="36"
          />
          <span class="footer__wordmark">Immun<b>OS</b></span>
        </div>
        <p class="footer__blurb">{footer.blurb}</p>
      </div>

      <div class="footer__cols">
        {
          footer.columns.map((col) => (
            <div class="footer__col">
              <div class="footer__col-title">{col.title}</div>
              {col.links.map((l) => (
                <a
                  class="footer__link"
                  href={l.href}
                  {...(l.href.startsWith("http") ? { target: "_blank", rel: "noreferrer" } : {})}
                >
                  {l.label}
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="footer__bottom">
      <span class="footer__year">ImmunOS, {footer.year}</span>
      <a
        class="footer__aria"
        href="https://www.aria.org.uk/"
        target="_blank"
        rel="noreferrer"
        aria-label="Powered by the Advanced Research and Invention Agency"
      >
        <img
          src="/brand/aria-powered-by.png"
          alt=""
          width="220"
          height="64"
        />
      </a>
    </div>
  </div>
</footer>

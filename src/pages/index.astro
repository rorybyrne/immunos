---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/HomeHero.astro";
import NextSession from "../components/NextSession.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import site from "../data/site.json";

const meetings = await getCollection("meetings");
const upcoming = meetings
  .filter((m) => m.data.status === "upcoming")
  .sort((a, b) => Number(a.data.no) - Number(b.data.no))[0];
---

<Layout activePage="home">
  <HomeHero
    headline={site.home.headline}
    lede={site.home.lede}
    context={site.home.context}
  />

  {upcoming && <NextSession next={upcoming.data} />}

  <WhoWeAre />
</Layout>

---
import SectionHead from "./SectionHead.astro";
import { getCollection } from "astro:content";
import "./WhoWeAre.css";

const team = await getCollection("team");
team.sort((a, b) => a.data.order - b.data.order);
---

<section class="section who-we-are">
  <div class="shell">
    <SectionHead title="Who we are" />

    <p class="who-we-are__intro">
      Alex and Inga co-founded ImmunOS to propose a paradigm shift in how to think about, and
      engage with, the immune system. Bringing together a core team of ten individuals across
      academia, industry, and startups, we are now doing exactly that:
      redefining and re-engineering the immunology textbook, one concept at a time.
    </p>

    <div class="affiliate-grid">
      {
        team.map((m, i) => {
          const portrait = m.data.portrait;
          const linkAttrs = m.data.website
            ? { href: m.data.website, target: "_blank", rel: "noreferrer" }
            : {};
          const Tag = m.data.website ? "a" : "div";
          return (
            <Tag class="affiliate-cell" {...linkAttrs}>
              <div
                class:list={[
                  "affiliate-cell__portrait",
                  { [`affiliate-cell__portrait--v${(i % 4) + 1}`]: !portrait },
                ]}
              >
                {portrait && (
                  <img
                    class="affiliate-cell__portrait-img"
                    src={portrait}
                    alt={`Portrait of ${m.data.name}`}
                    loading="lazy"
                  />
                )}
              </div>

              <div class="affiliate-cell__name">{m.data.name}</div>
              {m.data.role && <div class="affiliate-cell__role">{m.data.role}</div>}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

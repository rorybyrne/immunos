---
import "./TeamMemberCard.css";

interface Props {
  name: string;
  role?: string;
  interest?: string;
  bio?: string;
  affiliation?: string;
  portrait?: string;
  website?: string;
  index: number;
}

const { name, role, interest, bio, affiliation, portrait, website, index } = Astro.props;
const portraitVariant = `team-card__portrait--v${(index % 6) + 1}`;
const portraitNumber = String(index + 1).padStart(2, "0");

/* The whole card links to the member's site when they have one. */
const Tag = website ? "a" : "article";
const linkAttrs = website
  ? { href: website, target: "_blank", rel: "noreferrer" }
  : {};
---

<Tag class="team-card" {...linkAttrs}>
  <div class:list={["team-card__portrait", { [portraitVariant]: !portrait }]}>
    {portrait ? (
      <img class="team-card__portrait-img" src={portrait} alt={`Portrait of ${name}`} loading="lazy" />
    ) : (
      <>
        <div class="team-card__portrait-overlay" aria-hidden="true"></div>
        <span class="team-card__portrait-label">Portrait {portraitNumber}</span>
      </>
    )}
  </div>
  <div class="team-card__body">
    <h3 class="team-card__name">{name}</h3>
    {role && <div class="team-card__role">{role}</div>}
    {interest && <p class="team-card__interest">{interest}</p>}
    {bio && <p class="team-card__bio">{bio}</p>}
  </div>
</Tag>

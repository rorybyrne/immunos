---
import "./MeetingEntry.css";

interface Link {
  title: string;
  meta: string;
  href: string;
}

interface PollResult {
  label: string;
  n: number;
}

interface Props {
  meeting: {
    no: string;
    title: string;
    date: string;
    venue: string;
    attendance?: number;
    open?: boolean;
    image?: { src?: string; caption?: string };
    speaker?: { name: string; role: string; bio: string };
    writing: Link[];
    fieldNews: Link[];
    industryNews: Link[];
    questions: string[];
    poll?: { q: string; results: PollResult[] };
    tools: Link[];
  };
  isLast?: boolean;
}

const { meeting, isLast } = Astro.props;
const pollTotal = meeting.poll?.results.reduce((s, r) => s + r.n, 0) ?? 0;
---

<article class:list={["meeting-entry", { "meeting-entry--last": isLast }]}>
  <details class="meeting-entry__details" open={meeting.open}>
    <summary class="meeting-entry__summary">
      <div class="meeting-entry__head">
        <span class="meeting-entry__no">{meeting.no}</span>
        <div class="meeting-entry__head-text">
          <h2 class="meeting-entry__title">{meeting.title}</h2>
          <div class="meeting-entry__head-meta">
            <span>{meeting.date}</span>
            <span class="meeting-entry__sep" aria-hidden="true">·</span>
            <span>{meeting.venue}</span>
            {meeting.attendance !== undefined && (
              <>
                <span class="meeting-entry__sep" aria-hidden="true">·</span>
                <span>{meeting.attendance} attendees</span>
              </>
            )}
            {meeting.speaker && (
              <>
                <span class="meeting-entry__sep" aria-hidden="true">·</span>
                <span>with {meeting.speaker.name}</span>
              </>
            )}
          </div>
        </div>
        <span class="meeting-entry__toggle">
          <span class="meeting-entry__toggle-open">Read +</span>
          <span class="meeting-entry__toggle-close">Close —</span>
        </span>
      </div>
    </summary>

    <div class="meeting-entry__body">
      {
        meeting.image && (
          <figure class="meeting-entry__figure">
            {meeting.image.src ? (
              <img
                class="meeting-entry__figure-img"
                src={meeting.image.src}
                alt=""
                loading="lazy"
              />
            ) : (
              <div class="meeting-entry__figure-placeholder" aria-hidden="true" />
            )}
            {meeting.image.caption && (
              <figcaption class="meeting-entry__figcaption">{meeting.image.caption}</figcaption>
            )}
          </figure>
        )
      }

      <div class="meeting-entry__grid">
        {meeting.speaker && (
          <section class="meeting-entry__section">
            <div class="meeting-entry__label">Speaker</div>
            <h3 class="meeting-entry__speaker-name">{meeting.speaker.name}</h3>
            <div class="meeting-entry__speaker-role">{meeting.speaker.role}</div>
            <p class="meeting-entry__speaker-bio">{meeting.speaker.bio}</p>
          </section>
        )}

        <section class="meeting-entry__section">
          <div class="meeting-entry__label">Our writing</div>
          <ul class="meeting-entry__links">
            {meeting.writing.map((w) => (
              <li>
                <a class="meeting-entry__link" href={w.href}>{w.title}</a>
                <span class="meeting-entry__link-meta">{w.meta}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="meeting-entry__section">
          <div class="meeting-entry__label">Field news</div>
          <ul class="meeting-entry__links">
            {meeting.fieldNews.map((w) => (
              <li>
                <a class="meeting-entry__link" href={w.href}>{w.title}</a>
                <span class="meeting-entry__link-meta">{w.meta}</span>
              </li>
            ))}
          </ul>
        </section>

        {
          meeting.industryNews.length > 0 && (
            <section class="meeting-entry__section">
              <div class="meeting-entry__label">Industry news</div>
              <ul class="meeting-entry__links">
                {meeting.industryNews.map((w) => (
                  <li>
                    <a class="meeting-entry__link" href={w.href}>{w.title}</a>
                    <span class="meeting-entry__link-meta">{w.meta}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="meeting-entry__section">
          <div class="meeting-entry__label">Provocations</div>
          <ol class="meeting-entry__provocations">
            {meeting.questions.map((q) => <li>{q}</li>)}
          </ol>
        </section>

        {
          meeting.poll && (
            <section class="meeting-entry__section">
              <div class="meeting-entry__label">Room poll</div>
              <div class="meeting-entry__poll-q">{meeting.poll.q}</div>
              {meeting.poll.results.map((r) => {
                const pct = pollTotal === 0 ? 0 : (r.n / pollTotal) * 100;
                return (
                  <div class="meeting-entry__poll-row">
                    <div class="meeting-entry__poll-row-top">
                      <span class="meeting-entry__poll-label">{r.label}</span>
                      <span class="meeting-entry__poll-count">{r.n}</span>
                    </div>
                    <div class="meeting-entry__poll-track">
                      <div class="meeting-entry__poll-bar" style={`width: ${pct}%`} />
                    </div>
                  </div>
                );
              })}
              <div class="meeting-entry__poll-foot">n = {pollTotal} · show of hands, end of session</div>
            </section>
          )
        }

        {
          meeting.tools.length > 0 && (
            <section class="meeting-entry__section">
              <div class="meeting-entry__label">Tools &amp; artefacts</div>
              <ul class="meeting-entry__links">
                {meeting.tools.map((w) => (
                  <li>
                    <a class="meeting-entry__link" href={w.href}>{w.title}</a>
                    <span class="meeting-entry__link-meta">{w.meta}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </details>
</article>

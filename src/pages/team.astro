---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import TeamMemberCard from "../components/TeamMemberCard.astro";
import site from "../data/site.json";

const team = await getCollection("team");
team.sort((a, b) => a.data.order - b.data.order);
---

<Layout activePage="team" title={site.team.headline}>
  <section class="section-hero team-page">
    <div class="shell">
      <PageHeader
        headline={site.team.headline}
        lede={site.team.lede}
        layout="stacked"
      />

      <div class="team-grid">
        {
          team.map((entry, i) => (
            <TeamMemberCard
              name={entry.data.name}
              role={entry.data.role}
              interest={entry.data.interest}
              bio={(entry.body ?? "").trim()}
              affiliation={entry.data.affiliation}
              portrait={entry.data.portrait}
              website={entry.data.website}
              index={i}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16) var(--space-12);
    max-width: 900px;
    margin-inline: auto;
  }

  @media (max-width: 720px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-12) var(--space-6); }
  }

  /* Team-page header fills the shell so each line stays on one line. */
  .team-page :global(.page-header__headline),
  .team-page :global(.page-header__lede) {
    max-width: none;
  }
</style>

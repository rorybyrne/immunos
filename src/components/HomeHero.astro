---
import "./HomeHero.css";
import HeroAnimation from "./HeroAnimation.astro";

interface Props {
  headline: string;
  lede: string;
  context: {
    convenedBy: string;
    convenedHref: string;
    facts: string[];
  };
}

const { headline, lede, context } = Astro.props;
---

<section class="section-hero home-hero">
  <div class="shell home-hero__inner">
    <div class="home-hero__content">
      <h1 class="home-hero__headline" set:html={headline}></h1>

      <p class="home-hero__lede" set:html={lede}></p>

      <p class="home-hero__context">
        <span>
          Convened by <a class="home-hero__convened" href={context.convenedHref}>{context.convenedBy}</a>.
        </span>
        {context.facts.map((fact) => <span class="home-hero__fact">{fact}</span>)}
      </p>
    </div>

    <div class="home-hero__visual">
      <HeroAnimation />
    </div>
  </div>
</section>
